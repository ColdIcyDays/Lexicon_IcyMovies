@model IEnumerable<IcyMovies.Models.Movie>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

@*
DATABASES:

Movie databases <-- Only movie data (NO FKs)

Review database <-- Only reviews (FK to movie)

Calculated Rating database <-- Only calculated database (FK to movie)
*@

<div class="w-[calc(100svw - 128px)] h-full m-8 h-16 shadow-lg rounded-2xl flex flex-col">
    <div class="p-8 grid grid-cols-2">
        <div>
            <h1>Manage Movies</h1>
            <p>View, search and manage movies in the system.</p>
        </div>
        
        <div class="flex">
            <div class="ml-auto rounded-lg bg-blue-600 w-fit p-4">
                <span>Add New Movie</span>
            </div>
        </div>
        
    </div>
    <hr class="mx-4 border-dotted"/>

    <div class="p-8">
        <div>
            <h1>Search goes here</h1>
        </div>

        <div>
            <table class="mx-4 mt-4 w-full">
                <thead>
                <tr>
                    <th>
                        #
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Title)
                    </th>
                    
                    <th>
                        @Html.DisplayNameFor(model => model.Genre)
                    </th>
                    <th>
                        Rating
                    </th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Id)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Title)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Genre)
                        </td>
                        <td>
                            N/A
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                            <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <hr class="mx-4 border-dotted"/>
    <div class="flex flex-row p-8">
        <div>
            <p>Showing x/x entries</p>
        </div>
        
        <div class="ml-auto flex flex-row gap-2">
            <div class="w-8 h-8 rounded-lg bg-gray-400 flex">
                <span class="m-auto w-min h-min"><</span>
            </div>
            
            <div class="w-8 h-8 rounded-lg bg-blue-600 flex">
                <span class="m-auto w-min h-min">1</span>
                
            </div>
            
            <div class="w-8 h-8 rounded-lg bg-gray-400 flex">
                <span class="m-auto w-min h-min">></span>
                
            </div>
        </div>
    </div>
</div>

