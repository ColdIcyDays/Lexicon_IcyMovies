@*@model IEnumerable<IcyMovies.Models.Movie>*@
@model IcyMovies.Models.Viewmodels.OffsetMovie

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*
DATABASES:

Movie databases <-- Only movie data (NO FKs)

Review database <-- Only reviews (FK to movie)

Calculated Rating database <-- Only calculated database (FK to movie)
*@


<div class="p-8 w-[calc(100svw - 128px)] h-full">
    
    <div class="w-full h-full shadow-lg ring-2 ring-black/25 rounded-2xl flex flex-col">
        <div class="p-8 grid grid-cols-2">
            <div>
                <h1>Manage Movies</h1>
                <p>View, search and manage movies in the system.</p>
            </div>
        
            <div class="flex flex-col gap-4">
                <a class="ml-auto rounded-lg bg-blue-600 w-fit p-4 text-white" asp-controller="Movie" asp-action="Create">
                    <span>Add New Movie</span>
                </a>
            </div>
        
        </div>
        <hr class="mx-4 border-dotted"/>

        <div class="p-8 h-[777px] ">
            <div class="w-full">
                <h1>Search by name</h1>
                <form method="get">
                    <input class="rounded-md ring" value="@Model.NameFilter" type="text" name="nameFilter"/>
                    <input class="rounded-md ring" value="0" type="number" name="pageNumber" hidden/>
                    <button type="submit" class="cursor-pointer w-max h-full ring rounded-md p-2 ml-4 text-center">Filter</button>
                    @*<a asp-controller="Movie" asp-action="Index"
                       asp-route-pageNumber="@(0)" asp-route-NameFilter= class="w-full h-full text-center">Filter</a>*@
                </form>
            </div>

            <div>
                <table class="mx-4 mt-4 w-full border-separate border-spacing-4">
                    <thead>
                    <tr class="h-16">
                        <th>
                            #
                        </th>
                        <th class="w-1/4">
                            Title
                            @*@Html.DisplayNameFor(model => model.Title)*@
                        </th>
                    
                        <th>
                            Genre
                            @*@Html.DisplayNameFor(model => model.Genre)*@
                        </th>
                        <th>
                            Rating
                        </th>
                        <th class="w-1/3"></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (Movie item in Model.FoundMovies)
                    {
                        <tr class="text-center h-32">
                            <td>
                                @Html.DisplayFor(modelItem => item.Id)
                            </td>
                            <td class="text-start">
                                <div class="m-auto grid grid-cols-2 w-max gap-5">
                                    <img src="@item.PosterURL" class="w-32"/>
                                    <div class="my-auto">
                                        @Html.DisplayFor(modelItem => item.Title)
                                    </div>
                                </div>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Genre)
                            </td>
                            <td>
                                N/A
                            </td>
                            <td>
                                <a class="rounded-lg min-w-[80px] bg-clr-10-1 p-4 text-white" asp-action="Edit" asp-route-id="@item.Id">Edit</a> 
                                <a class="rounded-lg min-w-[80px] bg-clr-10-1 p-4 text-white" asp-action="Details" asp-route-id="@item.Id">Details</a> 
                                <a class="rounded-lg min-w-[80px] bg-clr-10-1 p-4 text-white" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="flex flex-col p-8">
            <hr class="mx-4 w-full border-dotted "/>
            <div class="flex flex-row pt-8">
                <div>
                    <p>Showing @(Model.Offset + 1)/@Model.PaginationCount entries</p>
                </div>
            
                <div class="ml-auto flex flex-row gap-2">
                    <div class="w-8 h-8 rounded-lg bg-gray-400 flex">
                        <a asp-controller="Movie" asp-action="Index" 
                           asp-route-nameFilter="@(Model.NameFilter)"
                           asp-route-pageNumber="@(Model.Offset - 1 <= 0 ? 0 : Model.Offset - 1)" class="w-full h-full text-center"><</a>
                    </div>
                
                    <div class="w-8 h-8 rounded-lg bg-blue-600 flex">
                        <span class="m-auto w-min h-min text-white">1</span>
                    
                    </div>
                
                    <div class="w-8 h-8 rounded-lg bg-gray-400 flex">
                        <a asp-controller="Movie" asp-action="Index" 
                           asp-route-pageNumber="@(Model.Offset + 1 >= Model.PaginationCount ? Model.Offset : Model.Offset + 1)" 
                           asp-route-nameFilter="@(Model.NameFilter)"
                           class="w-full h-full text-center">></a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
