<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - IcyMovies</title>
    <script type="importmap"></script>
    @*<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>*@
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true">
    <link rel="stylesheet" href="~/IcyMovies.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="mb-3 h-16 flex flex-row border-b-1">
        <div class="flex flex-row grow border-r-2">
            <div class="navbar-element flex">
                <a class="m-auto w-full h-full flex" asp-controller="Home" asp-action="Index"><span class="m-auto">Home</span></a>
            </div>
            <div class="navbar-element flex">
                <a class="m-auto w-full h-full flex" asp-controller="Movie" asp-action="Index"><span class="m-auto">Something</span></a>
            </div>
            <div class="navbar-element flex">
                <a class="m-auto w-full h-full flex" asp-controller="Movie" asp-action="Index"><span class="m-auto">Huh?</span></a>
            </div>
            
        </div>

        @* User login status *@
        <div class="flex flex-row grow">
            <div class="navbar-element flex">
                <a class="m-auto w-full h-full flex" asp-controller="Movie" asp-action="Index"><span class="m-auto">Edit database</span></a>
            </div>
            
            <div class="navbar-element flex">
                <a class="m-auto w-full h-full flex" asp-controller="Movie" asp-action="Index"><span class="m-auto">User</span></a>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - IcyMovies - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>