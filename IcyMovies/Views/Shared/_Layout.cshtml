<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - IcyMovies</title>
    <script type="importmap"></script>
    @*<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>*@
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true">
    <link rel="stylesheet" href="~/IcyMovies.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="mb-3 flex flex-row">
        <div class="h-64 flex flex-row grow border-b-1 bg-cyan-500">
            <div class="">
                <p>Hello nav bar</p>
            </div>
            
            <div class="">
                <p>Hello nav bar</p>
            </div>
            
        </div>

        @* User login status *@
        <div class="border-b-4 border-black">
            <p>Im the user</p>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - IcyMovies - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>