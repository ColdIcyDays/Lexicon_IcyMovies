
<!DOCTYPE html>
<html lang="en" class="h-min">
<div>
    
</div>
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - IcyMovies</title>
    <script type="importmap"></script>
    @*<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>*@
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true">
    <link rel="stylesheet" href="~/IcyMovies.styles.css" asp-append-version="true"/>
</head>
<body class="flex flex-col">
<header>
    <nav class="h-16 flex flex-row border-black bg-white">
        <div class="pr-12 pl-4">
            <div for-page="/" class="navbar-element flex text-4xl">
                <a class="m-auto w-full h-full flex" asp-controller="Home" asp-action="Index">
                    <div class="w-max h-max m-auto flex flex-row">
                        <h2>Icy</h2>
                        <h2 class="text-clr-10-1 pl-2">Movies</h2>
                    </div>
                </a>
            </div>
        </div>
        <div class="flex flex-row grow gap-1">

            <IcyNavbarTagHelper for-page="/" class="navbar-element flex">
                <a id="linkToHome" class="m-auto w-full h-full flex <%: GetLocationCssClassName() %>" asp-controller="Home" asp-action="Index"><span class="m-auto">Home</span></a>
            </IcyNavbarTagHelper>
            
            <IcyNavbarTagHelper for-page="/Home/Movies" class="navbar-element flex">
                <a id="linkToMovies" class="m-auto w-full h-full flex" asp-controller="Home" asp-action="Movies"><span class="m-auto">Movies</span></a>
            </IcyNavbarTagHelper>

        </div>

        @* User login status *@
        <div class="flex flex-row grow">
            <div class="navbar-element flex">
                <a id="linkToEditDB" class="m-auto w-full h-full flex" asp-controller="Movie" asp-action="Index"><span class="m-auto">Edit database</span></a>
            </div>

            <div class="navbar-element flex">
                <a class="m-auto w-full h-full flex" asp-controller="Movie" asp-action="Index"><span class="m-auto">User</span></a>
            </div>
        </div>
    </nav>
</header>
<div class="w-full grow">
    <main role="main" class="w-full h-full bg-white">
        @RenderBody()
    </main>
</div>

<footer class="border-t border-dotted footer text-muted mt-auto p-8">
    <div class="container">
        &copy; 2026 - IcyMovies - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
