@model IEnumerable<IcyMovies.Models.Movie>

@foreach (Movie item in Model.Take(3))
{
<div class="flex flex-col bg-clr-60-1 rounded-lg w-[33%] h-[512px]">
    <div class="h-[45%] overflow-hidden">
        <img src="@item.PosterURL" class="w-full object-fill"/>
    </div>
    <div class="bg-clr-30-1 w-full h-[55%] p-4 flex flex-col">
        <h2>
            @Html.DisplayFor(model => item.Title)
        </h2>
        <div class="flex flex-row gap-2">
            <h3>
                @Html.DisplayFor(model => item.Genre)
            </h3>
            <h3>
                |
            </h3>
            <h3>
                @Html.DisplayFor(model => item.ReleaseDate.Year)
            </h3>
        </div>
        <div class="h-1/3 overflow-y-hidden">
            <p>
                @Html.DisplayFor(model => item.ShortDescription)
            </p>
        </div>
        <div class="flex flex-row mt-auto">
            <input type="button" value="Watch now" class="p-4 bg-clr-10-2 rounded-lg"/>
            <input type="button" value="+" class="w-12 h-12 bg-clr-10-2 rounded-[50%] my-auto ml-auto"/>
        </div>
    </div>
</div>
}